# Server
SERVER_PORT=8080

# Database (PostgreSQL - docker-compose maps to host port 5433)
DB_HOST=localhost
DB_PORT=5433
DB_USER=dermasense
DB_PASSWORD=dermasense_secret
DB_NAME=dermasense
DB_SSL_MODE=disable

# Redis (docker-compose maps to host port 6380)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# AI (SumoPod - OpenAI-compatible proxy)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://ai.sumopod.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# App
DEFAULT_FREE_SCANS=3
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
